# Salesforce Agent API Configuration
SALESFORCE_CLIENT_ID=your_connected_app_client_id
SALESFORCE_CLIENT_SECRET=your_connected_app_client_secret
SALESFORCE_DOMAIN=your_salesforce_domain
SALESFORCE_AGENT_ID=your_agent_id

# Slack OAuth (Sign in with Slack)
SLACK_CLIENT_ID=your_slack_app_client_id
SLACK_CLIENT_SECRET=your_slack_app_client_secret
SLACK_TEAM_ID=T01GST6QY0G

# Session encryption (min 32 characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=generate-a-secure-random-string-here

# Slack App integration (request processing)
SLACK_APP_URL=https://aicentre-slack-app.herokuapp.com
SLACK_APP_WEBHOOK_SECRET=your_shared_secret_here

# Team members - comma-separated Salesforce Contact IDs
TEAM_MEMBER_CONTACT_IDS=003XXXXXXXXXXXX,003XXXXXXXXXXXX

# App URL (for OAuth redirect URI)
NEXT_PUBLIC_APP_URL=http://localhost:3000