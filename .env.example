# Salesforce Agent API Configuration
SALESFORCE_CLIENT_ID=your_connected_app_client_id
SALESFORCE_CLIENT_SECRET=your_connected_app_client_secret
SALESFORCE_DOMAIN=your_salesforce_domain
SALESFORCE_AGENT_ID=your_agent_id
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# HMAC Authentication Secret
# Generate a secure random string for production
# Example: openssl rand -hex 32
SIGNED_URL_SECRET=your-secure-secret-key-here

# IP-based access control (existing)
ALLOWED_IP_ADDRESS=192.168.1.0/24

# Maintenance mode - set to "true" to take the site offline and show the
# "We'll be back soon" page to all visitors
MAINTENANCE_MODE=false

# Staging mode - set to "true" on a staging deploy (e.g. Heroku) to get
# dev-like behavior (auth bypass, local token caching). NODE_ENV is baked in
# at build time by Next.js, so it can't be used for this at runtime.
STAGING_MODE=false